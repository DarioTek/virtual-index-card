# Virtual Index Card configuration.
# Every variable is optional; the defaults below match src/virtual_index_card/config.py.
# Copy to .env and the app picks it up automatically at startup. Real environment
# variables always win over this file, so systemd EnvironmentFile overrides work.

# Location of the SQLite database. The parent directory is created on first start.
VIC_DATABASE_PATH=./data/virtual-index-card.sqlite3

# Session lifetime in seconds (default 7 days).
VIC_SESSION_TTL_SECONDS=604800

# Set to true only when the app is served over HTTPS. Secure cookies will not be
# sent over plain HTTP, so leaving this on during local development breaks login.
VIC_COOKIE_SECURE=false

# Expose the interactive API docs at /docs and /redoc plus /openapi.json.
# Leave false in production: the schema is unauthenticated.
VIC_ENABLE_DOCS=false

# Optional administrator bootstrap, applied on *every* startup.
# Required to create a missing admin; optional when promoting an existing account.
# VIC_ADMIN_PASSWORD reapplies on each start, so unset it after the first boot
# (or rotate the password on Admin -> Profile and remove it here).
#VIC_ADMIN_USERNAME=admin
#VIC_ADMIN_PASSWORD=change-me-and-remove-afterwards

# Caps for JSON deck export (/decks/{id}/export.json). Exceeding either returns 413.
VIC_MAX_EXPORT_ROWS=10000
VIC_MAX_EXPORT_BYTES=1048576
